{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "li4chess-architecture-spike-local-only",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "spike-v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "spike-local", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
