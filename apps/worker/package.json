{
  "name": "@li4chess/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.campaign-worker.json",
    "build": "tsc -p tsconfig.json",
    "build:assets": "tsx scripts/build.ts",
    "dev:local": "tsx scripts/dev.ts",
    "check:deploy": "tsx scripts/dry-run.ts",
    "check:room": "tsx scripts/room-dry-run.ts",
    "test:runtime": "tsx test/run.ts",
    "build:multiplayer": "tsx scripts/multiplayer-build.ts",
    "check:multiplayer": "tsx scripts/multiplayer-dry-run.ts",
    "test:multiplayer": "tsx test/multiplayer.ts",
    "test:campaign": "tsx test/campaign-tools-check.ts && tsx test/campaign-fixtures-check.ts && tsx test/campaign.ts",
    "test:replay": "tsx test/replay-campaign.ts",
    "test:rematch": "tsx test/campaign-tools-check.ts && tsx test/rematch-campaign.ts"
  },
  "dependencies": { "@li4chess/protocol": "workspace:*", "@li4chess/game-room": "workspace:*" },
  "devDependencies": {
    "@li4chess/engine": "workspace:*",
    "@li4chess/persistence": "workspace:*",
    "@cloudflare/workers-types": "5.20260906.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
